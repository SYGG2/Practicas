#include <iostream>
using namespace std;

int main() {
    int n, s = 0;
    cout << "Ingrese N: ";
    cin >> n;
    
    for (int i = 1; i <= n; i++) {
        if (i % 2 == 0) {
            s = s - i;
        } else {
            s = s + i;
        }
    }
    
    cout << "El resultado es: " << s << endl;
    return 0;
}
