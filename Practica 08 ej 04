#include <iostream>
using namespace std;

int leerTamano();
void leerVector(int a[], int n);
void mostrarVector(int v[], int n);
void invertirEnOtro(int a[], int b[], int n);

int main() {
    int a[100], b[100];
    int n = leerTamano();
    leerVector(a, n);

    invertirEnOtro(a, b, n);

    cout << "\nVector A: ";
    mostrarVector(a, n);
    cout << "Vector B (invertido): ";
    mostrarVector(b, n);

    return 0;
}

int leerTamano() {
    int n;
    do {
        cout << "Cantidad de elementos (1 a 100): ";
        cin >> n;
        if (n < 1 || n > 100) {
            cout << "Cantidad no valida, intente de nuevo." << endl;
        }
    } while (n < 1 || n > 100);
    return n;
}

void leerVector(int a[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "A[" << i << "]: ";
        cin >> a[i];
    }
}

void mostrarVector(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}

// El ultimo de A pasa a ser el primero de B, y asi sucesivamente
void invertirEnOtro(int a[], int b[], int n) {
    for (int i = 0; i < n; i++) {
        b[i] = a[n - 1 - i];
    }
}
