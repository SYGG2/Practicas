#include <iostream>
using namespace std;

int leerTamano();
void leerVector(double v[], int n);
void mostrarVector(double v[], int n);
double buscarMinimo(double v[], int n);

int main() {
    double v[100];
    int n = leerTamano();
    leerVector(v, n);

    cout << "\nVector ingresado: ";
    mostrarVector(v, n);

    double menor = buscarMinimo(v, n);
    cout << "El valor minimo es: " << menor << endl;

    return 0;
}

int leerTamano() {
    int n;
    do {
        cout << "Cantidad de elementos (1 a 100): ";
        cin >> n;
        if (n < 1 || n > 100) {
            cout << "Cantidad no valida, intente de nuevo." << endl;
        }
    } while (n < 1 || n > 100);
    return n;
}

void leerVector(double v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Elemento [" << i << "]: ";
        cin >> v[i];
    }
}

void mostrarVector(double v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}

double buscarMinimo(double v[], int n) {
    double menor = v[0];
    for (int i = 1; i < n; i++) {
        if (v[i] < menor) {
            menor = v[i];
        }
    }
    return menor;
}
