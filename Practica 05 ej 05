#include <iostream>
using namespace std;

int main() {
    int n, d, comp, res = 0, p = 1;
    cout << "Ingrese un numero: ";
    cin >> n;
    
    while (n > 0) {
        d = n % 10;
        comp = 9 - d;
        res = res + (comp * p);
        p = p * 10;
        n = n / 10;
    }
    
    cout << "Complemento a 9: " << res << endl;
    return 0;
}
