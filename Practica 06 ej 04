#include <iostream>
using namespace std;

void calcularDiferencia(int h1, int m1, int s1, int h2, int m2, int s2) {
    int seg1 = h1 * 3600 + m1 * 60 + s1;
    int seg2 = h2 * 3600 + m2 * 60 + s2;
    int dif = seg2 - seg1;
    
    int hf = dif / 3600;
    dif = dif % 3600;
    int mf = dif / 60;
    int sf = dif % 60;
    
    cout << "Tiempo transcurrido: " << hf << ":" << mf << ":" << sf << endl;
}

int main() {
    int h1, m1, s1, h2, m2, s2;
    cout << "Primer horario (hh mm ss): ";
    cin >> h1 >> m1 >> s1;
    cout << "Segundo horario (hh mm ss): ";
    cin >> h2 >> m2 >> s2;
    
    calcularDiferencia(h1, m1, s1, h2, m2, s2);
    return 0;
}
