#include <iostream>
using namespace std;

bool esBisiesto(int anio) {
    return (anio % 4 == 0 && anio % 100 != 0) || (anio % 400 == 0);
}

bool validarFecha(int d, int m, int a) {
    if (a < 1 || m < 1 || m > 12 || d < 1) return false;

    int diasDelMes = 31;
    if (m == 4 || m == 6 || m == 9 || m == 11) {
        diasDelMes = 30;
    } else if (m == 2) {
        diasDelMes = esBisiesto(a) ? 29 : 28;
    }

    return d <= diasDelMes;
}

int main() {
    int d, m, a;
    cout << "Ingrese dia, mes y anio: ";
    cin >> d >> m >> a;
    if (validarFecha(d, m, a)) cout << "Fecha valida." << endl;
    else cout << "Fecha invalida." << endl;
    return 0;
}
