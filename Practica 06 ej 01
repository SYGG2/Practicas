#include <iostream>
using namespace std;

float calcularCosto(float p) {
    if (p > 0 && p < 50) return 1.50;
    if (p >= 50 && p <= 100) return 4.00;
    if (p > 100 && p <= 200) return 6.00;
    if (p > 200 && p <= 350) return 10.50;
    if (p > 350 && p <= 500) return 15.00;
    return -1;
}

int main() {
    float p, costo;
    cout << "Ingrese el peso de la carta en gramos: ";
    cin >> p;
    
    costo = calcularCosto(p);
    
    if (costo == -1) {
        cout << "NO PUEDE ENVIAR COMO CARTA" << endl;
    } else {
        cout << "El costo de envio es: Bs. " << costo << endl;
    }
    return 0;
}
