#include <iostream>
using namespace std;

int leerTamano();
void leerVector(int a[], int n);
void mostrarVector(int v[], int n);
void invertir(int a[], int n);

int main() {
    int a[100];
    int n = leerTamano();
    leerVector(a, n);

    cout << "\nAntes de invertir: ";
    mostrarVector(a, n);

    invertir(a, n);

    cout << "Despues de invertir: ";
    mostrarVector(a, n);

    return 0;
}

int leerTamano() {
    int n;
    do {
        cout << "Cantidad de elementos (1 a 100): ";
        cin >> n;
        if (n < 1 || n > 100) {
            cout << "Cantidad no valida, intente de nuevo." << endl;
        }
    } while (n < 1 || n > 100);
    return n;
}

void leerVector(int a[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "A[" << i << "]: ";
        cin >> a[i];
    }
}

void mostrarVector(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}

// Intercambia los extremos hacia el centro usando una variable auxiliar
// Los arreglos se pasan por referencia automaticamente, asi que se modifica el original
void invertir(int a[], int n) {
    for (int i = 0; i < n / 2; i++) {
        int aux = a[i];
        a[i] = a[n - 1 - i];
        a[n - 1 - i] = aux;
    }
}
