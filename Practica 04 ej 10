#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int n, signo = 1;
    float x, s = 0;
    cout << "Ingrese X: ";
    cin >> x;
    cout << "Ingrese N (impar): ";
    cin >> n;
    
    for (int i = 1; i <= n; i += 2) {
        float fac = 1;
        for (int j = 1; j <= i; j++) {
            fac = fac * j;
        }
        s = s + signo * (pow(x, i) / fac);
        signo = signo * -1;
    }
    
    cout << "El resultado es: " << s << endl;
    return 0;
}
