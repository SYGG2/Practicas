#include <iostream>
using namespace std;

int main() {
    int n;
    float x, s = 0, pot = 1, fac = 1;
    cout << "Ingrese X: ";
    cin >> x;
    cout << "Ingrese N: ";
    cin >> n;
    
    for (int i = 1; i <= n; i++) {
        pot = pot * x;
        fac = fac * i;
        s = s + (pot / fac);
    }
    
    cout << "El resultado es: " << s << endl;
    return 0;
}
