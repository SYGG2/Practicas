#include <iostream>
using namespace std;

void desglosar(int n, int &u, int &d, int &c, int &m) {
    u = n % 10;
    d = (n / 10) % 10;
    c = (n / 100) % 10;
    m = (n / 1000) % 10;
}

int main() {
    int n, u, d, c, m;
    cout << "Ingrese un numero entero positivo menor a 10000: ";
    cin >> n;
    
    if (n > 0 && n < 10000) {
        desglosar(n, u, d, c, m);
        cout << "Unidades de mil (m): " << m << endl;
        cout << "Centenas (c): " << c << endl;
        cout << "Decenas (d): " << d << endl;
        cout << "Unidades (u): " << u << endl;
    } else {
        cout << "Numero fuera de rango." << endl;
    }
    return 0;
}
