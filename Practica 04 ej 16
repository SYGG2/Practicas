#include <iostream>
using namespace std;

int main() {
    int n, cont = 0;
    cout << "Ingrese un numero N: ";
    cin >> n;
    
    for (int i = 1; i <= n; i++) {
        if (n % i == 0) {
            cont++;
        }
    }
    
    if (cont == 2) {
        cout << n << " es primo." << endl;
    } else {
        cout << n << " no es primo." << endl;
    }
    
    return 0;
}
