#include <iostream>
using namespace std;

double POTEN(double x, int y) {
    double p = 1;
    for (int i = 1; i <= y; i++) p *= x;
    return p;
}

long long FAC(int n) {
    long long f = 1;
    for (int i = 1; i <= n; i++) f *= i;
    return f;
}

int main() {
    int x, n;
    double s = 0;
    cout << "Ingrese X y N (enteros positivos): ";
    cin >> x >> n;

    for (int i = 1; i <= n; i++) {
        s = s + (POTEN(x, i) / FAC(i));
    }

    cout << "Suma de la serie: " << s << endl;
    return 0;
}
