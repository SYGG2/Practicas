#include <iostream>
using namespace std;

int main() {
    int n;
    long long fac = 1;
    cout << "Ingrese un numero entero N: ";
    cin >> n;
    
    for (int i = 1; i <= n; i++) {
        fac = fac * i;
    }
    
    cout << "El factorial de " << n << " es: " << fac << endl;
    return 0;
}
