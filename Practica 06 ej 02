#include <iostream>
#include <cmath>
using namespace std;

void resolverCuadratica(float a, float b, float c) {
    float d = (b * b) - (4 * a * c);
    if (d >= 0 && a != 0) {
        float x1 = (-b + sqrt(d)) / (2 * a);
        float x2 = (-b - sqrt(d)) / (2 * a);
        cout << "x1 = " << x1 << endl;
        cout << "x2 = " << x2 << endl;
    } else {
        cout << "No tiene soluciones reales." << endl;
    }
}

int main() {
    float a, b, c;
    cout << "Ingrese a, b y c: ";
    cin >> a >> b >> c;
    
    resolverCuadratica(a, b, c);
    return 0;
}
