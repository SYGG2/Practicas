#include <iostream>
using namespace std;

int main() {
    int n, f0 = 1, f1 = 1, fn;
    cout << "Ingrese el valor de n: ";
    cin >> n;
    
    if (n == 0 || n == 1) {
        fn = 1;
    } else {
        for (int i = 2; i <= n; i++) {
            fn = f0 + f1;
            f0 = f1;
            f1 = fn;
        }
    }
    
    cout << "El termino Fibonacci F" << n << " es: " << fn << endl;
    return 0;
}
